#!/usr/bin/env python3
"""Run the screening system. Stages 1–3 fill the cache. Decisions are not written here."""

import os
import sys

# Hash seed is fixed before any dict iteration the process will rely on.
# Setting it after startup does not stick, so re-exec once when it is unset.
if os.environ.get("PYTHONHASHSEED") != "0":
    os.environ["PYTHONHASHSEED"] = "0"
    os.execv(sys.executable, [sys.executable, *sys.argv])

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from pipeline import main

if __name__ == "__main__":
    sys.exit(main())
